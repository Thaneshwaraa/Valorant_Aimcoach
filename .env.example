# ---------- LLM ----------
# Ollama's OpenAI-compatible endpoint. Swapping providers = changing this URL.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2:3b-instruct-q4_K_M
LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=400
# Informational only. Ollama's OpenAI-compatible endpoint ignores a per-request
# num_ctx, so this cannot change the loaded context. To change it, create a
# Modelfile variant (see scripts/setup_ollama.ps1) and point LLM_MODEL at it.
LLM_NUM_CTX=4096
LLM_TIMEOUT_S=120

# ---------- Database ----------
DATABASE_URL=sqlite:///./data/app.db

# ---------- RAG ----------
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=valorant_kb
KB_DIR=./data/kb
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=24
# Weight of dense (vector) vs sparse (BM25) in hybrid fusion. 0.0=pure BM25, 1.0=pure vector.
HYBRID_ALPHA=0.55

# ---------- Domain gate ----------
DOMAIN_GATE_ENABLED=true
DOMAIN_GATE_MIN_SCORE=0.28

# ---------- Speech (Phase 4-5) ----------
STT_MODEL=small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
PIPER_EXE=./data/voices/piper/piper.exe
PIPER_VOICE=./data/voices/en_US-ryan-high.onnx

# ---------- Server ----------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
